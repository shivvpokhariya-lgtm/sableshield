<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- SableShield site theme. Satoshi is the web font; Android has no
         bundled Satoshi here, so the system sans is used with the same
         tight tracking. Drop Satoshi-Regular.ttf and Satoshi-Bold.ttf
         into res/font/ and set android:fontFamily to get the exact font. -->
    <style name="Theme.SableShield" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/burgundy</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColor">@color/text</item>
    </style>
</resources>
